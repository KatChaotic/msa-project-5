@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container_Boundary(host, "Host") {
    Component(docker, "Docker", "", "Запуск и управление контейнерами")

    Component(docker_logs, "Docker Logs", "files", "Логи докера, сохраненные файлы")


    Container_Boundary(docker_containers, "Docker Containers") {
        Component(server, "Server", "WildFly/Java", "Сервер Java приложения с логикой валидации отчетов")

        Component(batch, "Batch", "SpringBatch/Java", "Задача на обработку и загрузку отчетов")

        Component(filebeat, "Filebeat", "", "Собирает логи из файлов")

        Component(logstash, "Logstash", "", "Агрегирует логи")

        Component(elastic, "ElasticSearch", "", "Индексация/поиск логов")

        Component(kibana, "Kibana", "", "UI для отображения логов")

        Component(prometheus, "Prometheus", "", "Сбор метрик")

        Component(grafana, "Grafana", "", "Дашборды метрик, алерты")
    }

}

Rel(filebeat, docker, "Получает", "метаданные")
Rel(filebeat, docker_logs, "Читает", "логи")

Rel(filebeat, logstash, "Публикует", "логи")
Rel(elastic, logstash, "Индексирует")

Rel(kibana, elastic, "Читает", "логи")

Rel(prometheus, server, "Собирает", "метрики")
Rel(prometheus, batch, "Собирает", "метрики")

Rel(grafana, prometheus, "Читает", "метрики")

Rel(docker, docker_logs, "Записывает", "логи")

Rel(docker, server, "Читает", "логи")
Rel(docker, batch, "Читает", "логи")

@enduml